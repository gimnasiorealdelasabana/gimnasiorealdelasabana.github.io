rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Solo estos correos (usuarios creados en Firebase Authentication) pueden
    // ver, editar y registrar pagos. Escribirlos en minúscula.
    function esColegio() {
      return request.auth != null
        && request.auth.token.email in ['grs.madrid2026@gmail.com', 'g.realdelasabana@gmail.com'];
    }

    // Configuración (valor, plazo, cupos): la leen los padres, solo la edita el colegio
    match /config/{doc} {
      allow read: if true;
      allow write: if esColegio();
    }

    match /inscripciones/{codigo} {
      // Los padres solo pueden CREAR una inscripción nueva, siempre "pendiente" y sin pago
      allow create: if request.resource.data.estado == 'pendiente'
                    && !('pago' in request.resource.data)
                    && request.resource.data.codigo == codigo
                    && request.resource.data.aceptaPEI == true
                    && request.resource.data.autorizaDatos == true
                    && request.resource.data.keys().size() < 120
                    // foto opcional, ya reducida en el navegador (máx. ~200 KB)
                    && (!('foto' in request.resource.data)
                        || (request.resource.data.foto is string && request.resource.data.foto.size() < 200000));
      // Consulta individual con el código exacto (el código es aleatorio y difícil de adivinar)
      allow get: if true;
      // Listar, registrar pagos, anular: solo rectoría y secretaría
      allow list, update, delete: if esColegio();
    }

    // ================= MATRÍCULA 2027 =================
    // La familia solo puede escribir en su matrícula si conoce el código Y el documento
    // del estudiante, y si el cupo ya está guardado (inscripción pagada).
    function familiaDe(codigo, numDoc) {
      let i = get(/databases/$(database)/documents/inscripciones/$(codigo)).data;
      return i.numDoc == numDoc && i.estado == 'guardado';
    }

    // Lo que llena la familia: factura vista, pago reportado, folio, documentos y firmas
    match /matriculas/{codigo} {
      allow get: if true;
      allow list, delete: if esColegio();
      allow create, update: if esColegio() || (
           request.resource.data.codigo == codigo
        && familiaDe(codigo, request.resource.data.numDoc)
        && request.resource.data.keys().hasOnly(['codigo', 'numDoc', 'anio', 'factura', 'pagoReportado', 'subidos',
             'folio', 'enviada', 'acuExpedida', 'acuCorreo', 'acepta', 'firmas', 'docs',
             'custodia', 'custodiaOtro', 'autorizaImagen']));
    }

    // Lo que decide el colegio: pago aprobado/rechazado, corrección, confirmación, carné.
    // La familia solo lo puede leer.
    match /matriculas_admin/{codigo} {
      allow get: if true;
      allow list, write: if esColegio();
    }

    // Documentos y soporte de pago (un archivo por documento, máx. ~1 MB)
    match /matriculas_docs/{id} {
      allow get: if true;
      allow list, delete: if esColegio();
      allow create, update: if esColegio() || (
           request.resource.data.codigo is string
        && id.matches(request.resource.data.codigo + '_[A-Za-z0-9_]+')
        && familiaDe(request.resource.data.codigo, request.resource.data.numDoc)
        && request.resource.data.data is string && request.resource.data.data.size() < 1000000);
    }

    // Consecutivos (factura, folio, carné): solo se pueden aumentar de 1 en 1
    match /contadores/{nombre} {
      allow get: if true;
      allow create: if esColegio() || request.resource.data.n == 1;
      allow update: if esColegio() || request.resource.data.n == resource.data.n + 1;
    }

    // Carné digital: cualquiera con el enlace/QR lo ve; solo el colegio lo crea
    match /carnets/{id} {
      allow get: if true;
      allow list, write: if esColegio();
    }

    // Cartera (matrícula y pensiones): solo el colegio
    match /cartera/{id} {
      allow read, write: if esColegio();
    }

    // Todo lo demás, cerrado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
